import numpy as np
from PIL import Image, ImageDraw

# ---------- Settings ----------
GRID_SIZE = 50        
CELL_PX = 12           
GENERATIONS = 120     
FRAME_MS = 120         
ALIVE_COLOR = (0, 230, 150)   
DEAD_COLOR = (15, 15, 25)     
BORDER_COLOR = (25, 25, 35)
SEED = 42

rng = np.random.default_rng(SEED)
grid = rng.choice([0, 1], size=(GRID_SIZE, GRID_SIZE), p=[0.78, 0.22])

shift = [-1, 1]

def step(grid):
    neighbors = (
        np.roll(grid, shift[0], axis=0) +
        np.roll(grid, shift[1], axis=0) +
        np.roll(grid, shift[0], axis=1) +
        np.roll(grid, shift[1], axis=1) +
        np.roll(np.roll(grid, shift[0], axis=0), shift[0], axis=1) +
        np.roll(np.roll(grid, shift[0], axis=0), shift[1], axis=1) +
        np.roll(np.roll(grid, shift[1], axis=0), shift[0], axis=1) +
        np.roll(np.roll(grid, shift[1], axis=0), shift[1], axis=1)
    )
    new_grid = np.zeros_like(grid)
    new_grid[(grid == 1) & ((neighbors == 2) | (neighbors == 3))] = 1
    new_grid[(grid == 0) & (neighbors == 3)] = 1
    return new_grid

def render(grid):
    size_px = GRID_SIZE * CELL_PX
    img = Image.new("RGB", (size_px, size_px), DEAD_COLOR)
    draw = ImageDraw.Draw(img)
    alive_ys, alive_xs = np.where(grid == 1)
    for y, x in zip(alive_ys, alive_xs):
        x0, y0 = x * CELL_PX, y * CELL_PX
        x1, y1 = x0 + CELL_PX - 1, y0 + CELL_PX - 1
        draw.rectangle([x0, y0, x1, y1], fill=ALIVE_COLOR)
    return img

frames = []
grid_store = {}
grid_store[0] = grid.copy()

frames.append(render(grid))

for gen in range(1, GENERATIONS + 1):
    grid = step(grid)
    frames.append(render(grid))

    if np.count_nonzero(grid) == 0:
        break
    if any((grid == g).all() for g in grid_store.values()):
        # hold on stable/oscillating end state a bit longer then stop
        break
    grid_store[gen] = grid.copy()

# pad a few extra frames at the end so it doesn't cut off abruptly
frames.extend([frames[-1]] * 6)

out_path = "/mnt/user-data/outputs/game_of_life.gif"
frames[0].save(
    out_path,
    save_all=True,
    append_images=frames[1:],
    duration=FRAME_MS,
    loop=0,
    optimize=True,
)
print(f"Saved {len(frames)} frames to {out_path}")
